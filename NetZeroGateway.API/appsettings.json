{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=NetZeroGatewayDB;Username=postgres;Password=abc-1234"
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_256BIT_SECRET_KEY_IN_PRODUCTION_00",
    "Issuer": "NetZeroGateway",
    "Audience": "NetZeroGatewayAdmin",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Encryption": {
    "Key": "CHANGE_THIS_TO_32_BYTE_KEY_IN_PROD"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Providers": {
    "Sms": { "BaseUrl": "http://smpp.revesms.com:7788" },
    "WhatsApp": { "BaseUrl": "https://app.watrend.com" },
    "Voice": { "BaseUrl": "http://api.sms.netzero.com.bd:8000" },
    "VoiceReport": { "BaseUrl": "http://api.sms.netzero.com.bd:8000" }
  },
  "HttpClients": {
    "TimeoutSeconds": 30,
    "ReportTimeoutSeconds": 60,
    "Retry": {
      "MaxAttempts": 3,
      "DelaySeconds": 2
    }
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "Seed": {
    "AdminUsers": [
      {
        "Username": "admin",
        "Password": "Admin@123",
        "Email": "admin@netzero.com",
        "Role": "SuperAdmin"
      },
      {
        "Username": "operator",
        "Password": "Operator@123",
        "Email": "operator@netzero.com",
        "Role": "Admin"
      }
    ],
    "XSoftApiKey": {
      "Label": "x-soft-default",
      "ApiKey": "xsoft_api_key_default",
      "SecretKey": "xsoft_secret_default"
    },
    "XSoftAppConfig": {
      "Label": "x-soft",
      "BaseUrl": "http://localhost:5050",
      "SharedSecret": "xsoft_shared_secret_default",
      "Description": "ASP.NET MVC 4.2 calling application"
    },
    "ChannelConfigs": [
      {
        "ChannelType": "SMS",
        "ProviderName": "SMS Provider",
        "Label": "SMS Default",
        "Config": {
          "apikey": "REPLACE_WITH_SMS_PROVIDER_API_KEY",
          "secretkey": "REPLACE_WITH_SMS_PROVIDER_SECRET",
          "callerID": "REPLACE_WITH_CALLER_ID",
          "baseUrl": "http://smpp.revesms.com:7788"
        }
      },
      {
        "ChannelType": "WP_Text",
        "ProviderName": "WhatsApp Provider",
        "Label": "WhatsApp Text Default",
        "Config": {
          "instance_id": "REPLACE_WITH_INSTANCE_ID",
          "access_token": "REPLACE_WITH_ACCESS_TOKEN",
          "baseUrl": "https://app.watrend.com"
        }
      },
      {
        "ChannelType": "WP_Media",
        "ProviderName": "WhatsApp Provider",
        "Label": "WhatsApp Media Default",
        "Config": {
          "instance_id": "REPLACE_WITH_INSTANCE_ID",
          "access_token": "REPLACE_WITH_ACCESS_TOKEN",
          "baseUrl": "https://app.watrend.com"
        }
      },
      {
        "ChannelType": "Voice",
        "ProviderName": "Voice Provider",
        "Label": "Voice Campaign Default",
        "Config": {
          "owner": "REPLACE_WITH_OWNER",
          "password": "REPLACE_WITH_PASSWORD",
          "authUserId": "REPLACE_WITH_AUTH_USER_ID",
          "lotNumber": "1",
          "campaignId": "REPLACE_WITH_CAMPAIGN_ID",
          "baseUrl": "http://api.sms.netzero.com.bd:8000"
        }
      }
    ],
    "FallbackPolicies": [
      {
        "Name": "WhatsApp fails to SMS",
        "TriggerChannel": "WP_Text",
        "FallbackChannel": "SMS",
        "IsActive": true,
        "IsGlobal": true,
        "Description": "Fallback to SMS when WhatsApp text delivery fails"
      },
      {
        "Name": "Voice fails to SMS",
        "TriggerChannel": "Voice",
        "FallbackChannel": "SMS",
        "IsActive": false,
        "IsGlobal": true,
        "Description": "Fallback to SMS when voice call fails"
      }
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithCorrelationId" ],
    "Properties": {
      "Application": "NetZeroGateway"
    }
  }
}
